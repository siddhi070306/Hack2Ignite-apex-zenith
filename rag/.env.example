RAG_PORT=8001
# Reuses the same OpenRouter key configured in backend/.env
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Minimum cosine similarity for a retrieved chunk to be considered grounding evidence.
# Below this, /rag/advice returns source="llm" (general knowledge) instead of "rag".
# Tuned against rag/eval.py for the TF-IDF retriever in rag/tfidf.py (22/22 passing at 0.15).
RAG_SIMILARITY_THRESHOLD=0.15
