RAG_PORT=8001
# Reuses the same OpenRouter key configured in backend/.env
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Minimum cosine similarity for a retrieved chunk to be considered grounding evidence.
# Below this, /rag/advice returns { grounded: false } rather than generating anything.
RAG_SIMILARITY_THRESHOLD=0.35
