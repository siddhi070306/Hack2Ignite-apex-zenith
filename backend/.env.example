PORT=3000
MONGODB_URI=mongodb://localhost:27017/apex_zenith
JWT_SECRET=change-this-secret-in-production
# Google OAuth Client ID for verification
GOOGLE_CLIENT_ID=your_google_client_id_here

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Sarvam AI (speech-to-text, text-to-speech, translation)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# Optional: URL of the rag/ Python service (see rag/README or rag/app.py). If unset or
# unreachable, triage advice simply falls back to the OpenRouter/rule-based text above.
RAG_SERVICE_URL=http://localhost:8001
